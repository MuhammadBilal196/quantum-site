# ── module: ./src/frontmatter.sa (src/frontmatter.sa) ──
# quantum-site / frontmatter — the "---" metadata block at the top of a page
#
#   let doc = FrontMatter.parse("---\ntitle: Hello\ntags: [news, quantum]\n---\nBody text")
#   doc["data"]["title"]     # "Hello"
#   doc["data"]["tags"]      # ["news", "quantum"]
#   doc["body"]              # "Body text"
#
# A small YAML subset: `key: value` lines, quoted strings, numbers, true/false/null,
# inline lists `[a, b]`, block lists (`- item` lines under `key:`) and one level of
# nested `key:` maps. Lines starting with # are comments.
#
# Exposes the global: FrontMatter

# @use ./util.sa

class __QFrontMatter {
    fn init() {}

    fn parse(text) {
        let src = SiteUtil.normalizeNewlines(text)
        if not (src.startsWith("---\n") or src == "---") {
            return {"data": {}, "body": src}
        }
        let lines = src.split("\n")
        let end = -1
        for k in range(1, len(lines)) {
            let t = SiteUtil.trimEnd(lines[k])
            if t == "---" or t == "..." {
                end = k
                break
            }
        }
        if end < 0 { return {"data": {}, "body": src} }
        let data = self.parseLines(lines.slice(1, end))
        let body = lines.slice(end + 1).join("\n")
        if body.startsWith("\n") { body = body.slice(1) }
        return {"data": data, "body": body}
    }

    # Renders a dict back to a front matter block (used by the `new` command).
    fn stringify(data, keys) {
        let lines = ["---"]
        for k in keys {
            if k in data { lines.push(k + ": " + self.valueText(data[k])) }
        }
        lines.push("---")
        return lines.join("\n") + "\n"
    }

    fn valueText(v) {
        if type(v) == "array" {
            let parts = []
            for x in v { parts.push(self.valueText(x)) }
            return "[" + parts.join(", ") + "]"
        }
        if type(v) == "string" {
            if v == "" or v.contains(":") or v.contains("#") or v.startsWith("[") or v.startsWith("\"") {
                return "\"" + v.replaceAll("\"", "\\\"") + "\""
            }
            return v
        }
        return SiteUtil.text(v)
    }

    fn parseLines(lines) {
        let data = {}
        let i = 0
        let n = len(lines)
        while i < n {
            let line = lines[i]
            let t = line.trim()
            if t == "" or t.startsWith("#") or SiteUtil.indentOf(line) > 0 {
                i += 1
                continue
            }
            let colon = t.indexOf(":")
            if colon <= 0 {
                i += 1
                continue
            }
            let key = t.slice(0, colon).trim()
            let rest = t.slice(colon + 1).trim()
            i += 1
            if rest != "" {
                data[key] = self.parseValue(rest)
                continue
            }
            # block list or nested map under this key
            let items = []
            let nested = {}
            let isMap = false
            while i < n and (lines[i].trim() == "" or SiteUtil.indentOf(lines[i]) > 0 or lines[i].trim().startsWith("- ")) {
                let sub = lines[i].trim()
                i += 1
                if sub == "" or sub.startsWith("#") { continue }
                if sub.startsWith("- ") or sub == "-" {
                    items.push(self.parseValue(sub.slice(1).trim()))
                } else {
                    let c = sub.indexOf(":")
                    if c > 0 {
                        nested[sub.slice(0, c).trim()] = self.parseValue(sub.slice(c + 1).trim())
                        isMap = true
                    }
                }
            }
            if isMap {
                data[key] = nested
            } else if len(items) > 0 {
                data[key] = items
            } else {
                data[key] = ""
            }
        }
        return data
    }

    fn parseValue(raw) {
        let s = raw.trim()
        if s == "" { return "" }
        let q = s[0]
        if (q == "\"" or q == "'") and len(s) >= 2 {
            let close = self.closingQuote(s, q)
            if close > 0 {
                let inner = s.slice(1, close)
                if q == "\"" { inner = inner.replaceAll("\\\"", "\"").replaceAll("\\n", "\n") }
                if q == "'" { inner = inner.replaceAll("''", "'") }
                return inner
            }
        }
        # trailing comment
        let hash = s.indexOf(" #")
        if hash > 0 { s = s.slice(0, hash).trim() }
        if s.startsWith("[") and s.endsWith("]") {
            let out = []
            for part in self.listParts(s.slice(1, len(s) - 1)) {
                if part.trim() != "" { out.push(self.parseValue(part)) }
            }
            return out
        }
        let low = s.lower()
        if low == "true" or low == "yes" { return true }
        if low == "false" or low == "no" { return false }
        if low == "null" or low == "~" { return null }
        if self.looksNumeric(s) { return num(s) }
        return s
    }

    fn closingQuote(s, q) {
        let k = 1
        while k < len(s) {
            if s[k] == "\\" and q == "\"" {
                k += 2
                continue
            }
            if s[k] == q {
                if q == "'" and k + 1 < len(s) and s[k + 1] == "'" {
                    k += 2
                    continue
                }
                return k
            }
            k += 1
        }
        return -1
    }

    # Comma-separated items, ignoring commas inside quotes.
    fn listParts(s) {
        let parts = []
        let cur = []
        let quote = ""
        for k in range(len(s)) {
            let c = s[k]
            if quote != "" {
                cur.push(c)
                if c == quote { quote = "" }
            } else if c == "\"" or c == "'" {
                quote = c
                cur.push(c)
            } else if c == "," {
                parts.push(cur.join(""))
                cur = []
            } else {
                cur.push(c)
            }
        }
        parts.push(cur.join(""))
        return parts
    }

    fn looksNumeric(s) {
        if s == "" or len(s) > 15 { return false }
        let first = (s[0] == "-" or s[0] == "+") ? 1 : 0
        if first == len(s) { return false }
        let dots = 0
        for k in range(first, len(s)) {
            if s[k] == "." {
                dots += 1
            } else if not s[k].isdigit() {
                return false
            }
        }
        if len(s) - first > 1 and s[first] == "0" and s[first + 1] != "." { return false }
        return dots <= 1
    }
}

FrontMatter = __QFrontMatter()

# ── module: ./src/markdown.sa (src/markdown.sa) ──
# quantum-site / markdown — Markdown to HTML (CommonMark core + GitHub extras)
#
#   Markdown.render("# Hi\n\nSome *text* and `code`.")
#   # <h1 id="hi">Hi</h1>
#   # <p>Some <em>text</em> and <code>code</code>.</p>
#
#   Markdown.headings(text)   # [{"level": 2, "text": "Install", "id": "install"}, ...]
#   Markdown.toc(text)        # <nav class="toc"> list of h2/h3 links
#
# Blocks: ATX headings (with ids), paragraphs, hard breaks, fenced and indented code,
# block quotes, nested ordered/unordered lists, task lists, tables with alignment,
# horizontal rules, raw HTML blocks, reference link definitions.
# Inline: **strong**, *em*, _em_, ~~strike~~, `code`, [links](url "title"),
# ![images](src), [ref][links], <autolinks>, bare https:// links, \escapes, inline HTML.
#
# Exposes the global: Markdown

# @use ./util.sa

class __QMarkdown {
    fn init() {
        self.ids = {}
        self.refs = {}
        self.BREAK = chr(2)
    }

    # ── public API ───────────────────────────────────────────────────────

    fn render(text) {
        if text == null { return "" }
        self.ids = {}
        self.refs = {}
        let lines = self.collectRefs(SiteUtil.normalizeNewlines(text).split("\n"))
        return self.renderBlocks(lines)
    }

    fn renderInline(text) {
        if text == null { return "" }
        return self.inline(SiteUtil.text(text)).replaceAll(self.BREAK, "<br>\n")
    }

    # Headings outside code blocks, with the same ids render() gives them.
    fn headings(text) {
        let saved = self.ids
        self.ids = {}
        let out = []
        let fence = ""
        for line in SiteUtil.normalizeNewlines(text).split("\n") {
            let t = line.trim()
            if fence != "" {
                if t.startsWith(fence) { fence = "" }
                continue
            }
            if t.startsWith("```") or t.startsWith("~~~") {
                fence = t.slice(0, 3)
                continue
            }
            let h = self.headingOf(line)
            if h != null {
                let html = self.inline(h["text"])
                let plain = SiteUtil.stripTags(html)
                out.push({"level": h["level"], "text": plain, "id": self.uniqueId(plain)})
            }
        }
        self.ids = saved
        return out
    }

    # A table of contents for levels minLevel..maxLevel (default 2..3), or "".
    fn toc(text, minLevel, maxLevel) {
        if minLevel == null { minLevel = 2 }
        if maxLevel == null { maxLevel = 3 }
        let items = []
        for h in self.headings(text) {
            if h["level"] >= minLevel and h["level"] <= maxLevel {
                items.push("<li class=\"toc-h" + SiteUtil.text(h["level"]) + "\"><a href=\"#" + h["id"] + "\">"
                    + SiteUtil.escapeHtml(h["text"]) + "</a></li>")
            }
        }
        if len(items) == 0 { return "" }
        return "<nav class=\"toc\"><ul>\n" + items.join("\n") + "\n</ul></nav>"
    }

    # ── reference definitions: [label]: url "title" ──────────────────────

    fn collectRefs(lines) {
        let kept = []
        let fence = ""
        for line in lines {
            let t = line.trim()
            if fence != "" {
                if t.startsWith(fence) { fence = "" }
                kept.push(line)
                continue
            }
            if t.startsWith("```") or t.startsWith("~~~") {
                fence = t.slice(0, 3)
                kept.push(line)
                continue
            }
            let ref = null
            if t.startsWith("[") and not t.startsWith("[^") and SiteUtil.indentOf(line) < 4 {
                ref = self.refOf(t)
            }
            if ref == null {
                kept.push(line)
            } else {
                self.refs[ref["label"]] = ref
            }
        }
        return kept
    }

    fn refOf(t) {
        let close = t.indexOf("]:")
        if close < 2 { return null }
        let label = t.slice(1, close).trim().lower()
        let rest = t.slice(close + 2).trim()
        if rest == "" or label == "" { return null }
        let dest = self.destination(rest)
        return {"label": label, "url": dest["url"], "title": dest["title"]}
    }

    # 'url "title"' -> {"url", "title"}
    fn destination(inside) {
        let s = inside.trim()
        let url = s
        let title = null
        let space = s.indexOf(" ")
        if space > 0 {
            url = s.slice(0, space)
            let rest = s.slice(space + 1).trim()
            if len(rest) >= 2 {
                let q = rest[0]
                if (q == "\"" or q == "'" or q == "(") and len(rest) >= 2 {
                    title = rest.slice(1, len(rest) - 1)
                }
            }
        }
        if url.startsWith("<") and url.endsWith(">") { url = url.slice(1, len(url) - 1) }
        return {"url": url, "title": title}
    }

    # ── blocks ───────────────────────────────────────────────────────────

    fn renderBlocks(lines) {
        let out = []
        let para = []
        let i = 0
        let n = len(lines)
        while i < n {
            let line = lines[i]
            let t = line.trim()

            if t == "" {
                self.flushPara(para, out)
                para = []
                i += 1
                continue
            }

            # fenced code
            if t.startsWith("```") or t.startsWith("~~~") {
                self.flushPara(para, out)
                para = []
                let fence = t.slice(0, 3)
                let info = t.slice(3).trim()
                let lang = info == "" ? "" : SiteUtil.words(info)[0]
                let indent = SiteUtil.indentOf(line)
                let code = []
                i += 1
                while i < n and not lines[i].trim().startsWith(fence) {
                    code.push(SiteUtil.dedent(lines[i], indent))
                    i += 1
                }
                i += 1
                let cls = lang == "" ? "" : " class=\"language-" + SiteUtil.escapeHtml(lang) + "\""
                let body = code.join("\n")
                if len(code) > 0 { body += "\n" }
                out.push("<pre><code" + cls + ">" + SiteUtil.escapeHtml(body) + "</code></pre>")
                continue
            }

            # indented code (not inside a paragraph)
            if len(para) == 0 and SiteUtil.indentOf(line) >= 4 {
                let code = []
                while i < n and (SiteUtil.indentOf(lines[i]) >= 4 or lines[i].trim() == "") {
                    code.push(SiteUtil.dedent(lines[i], 4))
                    i += 1
                }
                while len(code) > 0 and code[len(code) - 1].trim() == "" { code.pop() }
                out.push("<pre><code>" + SiteUtil.escapeHtml(code.join("\n") + "\n") + "</code></pre>")
                continue
            }

            # heading
            let h = self.headingOf(line)
            if h != null {
                self.flushPara(para, out)
                para = []
                let html = self.inline(h["text"])
                let hid = self.uniqueId(SiteUtil.stripTags(html))
                let tag = "h" + SiteUtil.text(h["level"])
                out.push("<" + tag + " id=\"" + hid + "\">" + html + "</" + tag + ">")
                i += 1
                continue
            }

            # horizontal rule
            if self.isRule(t) {
                self.flushPara(para, out)
                para = []
                out.push("<hr>")
                i += 1
                continue
            }

            # block quote
            if t.startsWith(">") {
                self.flushPara(para, out)
                para = []
                let quoted = []
                while i < n and lines[i].trim().startsWith(">") {
                    let q = lines[i].trim().slice(1)
                    if q.startsWith(" ") { q = q.slice(1) }
                    quoted.push(q)
                    i += 1
                }
                out.push("<blockquote>\n" + self.renderBlocks(quoted) + "\n</blockquote>")
                continue
            }

            # table: a row with pipes followed by a delimiter row
            if t.contains("|") and i + 1 < n and self.isTableRule(lines[i + 1].trim()) {
                self.flushPara(para, out)
                para = []
                let tableEnd = self.renderTable(lines, i, out)
                i = tableEnd
                continue
            }

            # list
            let marker = self.listMarker(line)
            if marker != null and (len(para) == 0 or not marker["ordered"] or marker["start"] == 1) {
                self.flushPara(para, out)
                para = []
                i = self.renderList(lines, i, out)
                continue
            }

            # raw HTML block
            if len(para) == 0 and self.isHtmlStart(t) {
                let block = []
                while i < n and lines[i].trim() != "" {
                    block.push(lines[i])
                    i += 1
                }
                out.push(block.join("\n"))
                continue
            }

            para.push(line)
            i += 1
        }
        self.flushPara(para, out)
        return out.join("\n")
    }

    fn flushPara(para, out) {
        if len(para) == 0 { return }
        let parts = []
        for j in range(len(para)) {
            let line = para[j]
            let last = j == len(para) - 1
            let body = line.trim()
            if not last and (line.endsWith("  ") or body.endsWith("\\")) {
                if body.endsWith("\\") { body = body.slice(0, len(body) - 1) }
                parts.push(SiteUtil.trimEnd(body) + self.BREAK)
            } else {
                parts.push(body)
            }
        }
        let html = self.inline(parts.join("\n"))
        out.push("<p>" + html.replaceAll(self.BREAK + "\n", "<br>\n").replaceAll(self.BREAK, "<br>\n") + "</p>")
    }

    # {"level", "text"} for "## Title ##", else null.
    fn headingOf(line) {
        if SiteUtil.indentOf(line) > 3 { return null }
        let t = line.trim()
        if not t.startsWith("#") { return null }
        let level = 0
        while level < len(t) and t[level] == "#" { level += 1 }
        if level > 6 { return null }
        if level < len(t) and t[level] != " " and t[level] != "\t" { return null }
        let body = t.slice(level).trim()
        # optional closing hashes
        let k = len(body)
        while k > 0 and body[k - 1] == "#" { k -= 1 }
        if k < len(body) and (k == 0 or body[k - 1] == " ") { body = body.slice(0, k).trim() }
        return {"level": level, "text": body}
    }

    fn uniqueId(text) {
        let base = SiteUtil.slugify(text)
        if base == "" { base = "section" }
        if not (base in self.ids) {
            self.ids[base] = 1
            return base
        }
        let count = self.ids[base]
        let candidate = base + "-" + SiteUtil.text(count)
        while candidate in self.ids {
            count += 1
            candidate = base + "-" + SiteUtil.text(count)
        }
        self.ids[base] = count + 1
        self.ids[candidate] = 1
        return candidate
    }

    fn isRule(t) {
        if len(t) < 3 { return false }
        let ch = t[0]
        if ch != "-" and ch != "*" and ch != "_" { return false }
        let count = 0
        for i in range(len(t)) {
            if t[i] == ch {
                count += 1
            } else if t[i] != " " and t[i] != "\t" {
                return false
            }
        }
        return count >= 3
    }

    fn isHtmlStart(t) {
        if len(t) < 3 or t[0] != "<" { return false }
        let c = t[1]
        return c.isalpha() or c == "/" or c == "!"
    }

    # ── lists ────────────────────────────────────────────────────────────

    # {"ordered", "start", "indent", "width", "text"} or null
    fn listMarker(line) {
        let indent = SiteUtil.indentOf(line)
        let t = SiteUtil.dedent(line, indent)
        if t == "" { return null }
        let c = t[0]
        if (c == "-" or c == "*" or c == "+") and (len(t) == 1 or t[1] == " " or t[1] == "\t") {
            if self.isRule(t.trim()) { return null }
            return {"ordered": false, "start": 1, "indent": indent, "width": 2, "text": t.slice(1).trim(), "bullet": c}
        }
        let k = 0
        while k < len(t) and k < 9 and t[k].isdigit() { k += 1 }
        if k > 0 and k < len(t) and (t[k] == "." or t[k] == ")") and (k + 1 == len(t) or t[k + 1] == " ") {
            return {"ordered": true, "start": num(t.slice(0, k)), "indent": indent, "width": k + 2,
                "text": t.slice(k + 1).trim(), "bullet": t[k]}
        }
        return null
    }

    # Renders the list starting at lines[i]; returns the index after it.
    fn renderList(lines, i, out) {
        let n = len(lines)
        let first = self.listMarker(lines[i])
        let base = first["indent"]
        let ordered = first["ordered"]
        let items = []
        let current = null
        let loose = false
        let blankBefore = false
        while i < n {
            let line = lines[i]
            if line.trim() == "" {
                blankBefore = true
                i += 1
                continue
            }
            let m = self.listMarker(line)
            let indent = SiteUtil.indentOf(line)
            if m != null and m["indent"] <= base + 1 and m["indent"] >= base - 1 {
                if m["ordered"] != ordered { break }
                if blankBefore and current != null { loose = true }
                current = {"lines": [m["text"]], "width": m["width"] + indent}
                items.push(current)
                blankBefore = false
                i += 1
                continue
            }
            if indent > base and current != null {
                if blankBefore {
                    current["lines"].push("")
                    loose = true
                }
                current["lines"].push(SiteUtil.dedent(line, current["width"]))
                blankBefore = false
                i += 1
                continue
            }
            # lazy paragraph continuation
            if not blankBefore and current != null and m == null and not self.startsBlock(line) {
                current["lines"].push(line.trim())
                i += 1
                continue
            }
            break
        }
        # A trailing blank line does not make the list loose.
        let tag = ordered ? "ol" : "ul"
        let openTag = "<" + tag
        if ordered and first["start"] != 1 { openTag += " start=\"" + SiteUtil.text(first["start"]) + "\"" }
        let hasTasks = false
        let rendered = []
        for item in items {
            let body = item["lines"]
            let task = ""
            let head = body[0]
            if head.startsWith("[ ] ") or head.startsWith("[x] ") or head.startsWith("[X] ") or head == "[ ]" or head == "[x]" {
                let checked = head[1] != " "
                task = "<input type=\"checkbox\" disabled" + (checked ? " checked" : "") + "> "
                body[0] = head.slice(3).trim()
                hasTasks = true
            }
            let html = self.renderBlocks(body)
            if not loose { html = self.unwrapFirstParagraph(html) }
            if task != "" {
                if html.startsWith("<p>") {
                    html = "<p>" + task + html.slice(3)
                } else {
                    html = task + html
                }
                rendered.push("<li class=\"task-list-item\">" + html + "</li>")
            } else {
                rendered.push("<li>" + html + "</li>")
            }
        }
        if hasTasks { openTag += " class=\"task-list\"" }
        out.push(openTag + ">\n" + rendered.join("\n") + "\n</" + tag + ">")
        return i
    }

    fn unwrapFirstParagraph(html) {
        if not html.startsWith("<p>") { return html }
        let close = html.indexOf("</p>")
        if close < 0 { return html }
        return html.slice(3, close) + html.slice(close + 4)
    }

    fn startsBlock(line) {
        let t = line.trim()
        return t.startsWith("#") or t.startsWith(">") or t.startsWith("```") or t.startsWith("~~~") or self.isRule(t)
    }

    # ── tables ───────────────────────────────────────────────────────────

    fn isTableRule(t) {
        if not t.contains("-") { return false }
        let pipes = t.contains("|")
        for k in range(len(t)) {
            let c = t[k]
            if c != "|" and c != "-" and c != ":" and c != " " and c != "\t" { return false }
        }
        return pipes or t.contains(":")
    }

    fn cellsOf(row) {
        let t = row.trim()
        if t.startsWith("|") { t = t.slice(1) }
        if t.endsWith("|") and not t.endsWith("\\|") { t = t.slice(0, len(t) - 1) }
        let cells = []
        let cell = []
        let inCode = false
        let k = 0
        while k < len(t) {
            let c = t[k]
            if c == "\\" and k + 1 < len(t) and t[k + 1] == "|" {
                cell.push("|")
                k += 2
                continue
            }
            if c == "`" { inCode = not inCode }
            if c == "|" and not inCode {
                cells.push(cell.join("").trim())
                cell = []
            } else {
                cell.push(c)
            }
            k += 1
        }
        cells.push(cell.join("").trim())
        return cells
    }

    fn renderTable(lines, i, out) {
        let n = len(lines)
        let header = self.cellsOf(lines[i])
        let aligns = []
        for spec in self.cellsOf(lines[i + 1]) {
            let s = spec.trim()
            let left = s.startsWith(":")
            let right = s.endsWith(":")
            if left and right {
                aligns.push(" style=\"text-align:center\"")
            } else if right {
                aligns.push(" style=\"text-align:right\"")
            } else if left {
                aligns.push(" style=\"text-align:left\"")
            } else {
                aligns.push("")
            }
        }
        let html = ["<table>", "<thead>", "<tr>"]
        for c in range(len(header)) {
            let a = c < len(aligns) ? aligns[c] : ""
            html.push("<th" + a + ">" + self.inline(header[c]) + "</th>")
        }
        html.push("</tr>")
        html.push("</thead>")
        i += 2
        let body = []
        while i < n and lines[i].trim() != "" and lines[i].contains("|") {
            let cells = self.cellsOf(lines[i])
            body.push("<tr>")
            for c in range(len(header)) {
                let a = c < len(aligns) ? aligns[c] : ""
                let v = c < len(cells) ? cells[c] : ""
                body.push("<td" + a + ">" + self.inline(v) + "</td>")
            }
            body.push("</tr>")
            i += 1
        }
        if len(body) > 0 {
            html.push("<tbody>")
            for row in body { html.push(row) }
            html.push("</tbody>")
        }
        html.push("</table>")
        out.push(html.join("\n"))
        return i
    }

    # ── inline ───────────────────────────────────────────────────────────

    fn inline(s) {
        let out = []
        let n = len(s)
        let i = 0
        let start = 0
        while i < n {
            let ch = s[i]

            if ch == "\\" and i + 1 < n and SiteUtil.isPunct(s[i + 1]) {
                self.flushText(s, start, i, out)
                out.push(SiteUtil.escapeHtml(s[i + 1]))
                i += 2
                start = i
                continue
            }

            if ch == "`" {
                let run = 0
                while i + run < n and s[i + run] == "`" { run += 1 }
                let ticks = SiteUtil.repeatText("`", run)
                let close = SiteUtil.indexFrom(s, ticks, i + run)
                if close >= 0 {
                    let code = s.slice(i + run, close)
                    if len(code) >= 2 and code.startsWith(" ") and code.endsWith(" ") and code.trim() != "" {
                        code = code.slice(1, len(code) - 1)
                    }
                    self.flushText(s, start, i, out)
                    out.push("<code>" + SiteUtil.escapeHtml(code.replaceAll("\n", " ")) + "</code>")
                    i = close + run
                    start = i
                } else {
                    i += run
                }
                continue
            }

            if (ch == "!" and i + 1 < n and s[i + 1] == "[") or ch == "[" {
                let image = ch == "!"
                let link = self.linkAt(s, image ? i + 1 : i)
                if link != null {
                    self.flushText(s, start, i, out)
                    let titleAttr = link["title"] == null ? "" : " title=\"" + SiteUtil.escapeHtml(link["title"]) + "\""
                    if image {
                        let alt = SiteUtil.stripTags(self.inline(link["text"]))
                        out.push("<img src=\"" + SiteUtil.escapeHtml(link["url"]) + "\" alt=\"" + SiteUtil.escapeHtml(alt) + "\"" + titleAttr + ">")
                    } else {
                        out.push("<a href=\"" + SiteUtil.escapeHtml(link["url"]) + "\"" + titleAttr + ">" + self.inline(link["text"]) + "</a>")
                    }
                    i = link["end"]
                    start = i
                    continue
                }
                i += 1
                continue
            }

            if ch == "<" {
                let close = SiteUtil.indexFrom(s, ">", i + 1)
                if close > i + 1 {
                    let inner = s.slice(i + 1, close)
                    if not inner.contains(" ") and (inner.startsWith("http://") or inner.startsWith("https://") or inner.startsWith("mailto:")) {
                        self.flushText(s, start, i, out)
                        out.push("<a href=\"" + SiteUtil.escapeHtml(inner) + "\">" + SiteUtil.escapeHtml(inner) + "</a>")
                        i = close + 1
                        start = i
                        continue
                    }
                    if not inner.contains(" ") and inner.contains("@") and inner.contains(".") and not inner.contains("/") {
                        self.flushText(s, start, i, out)
                        out.push("<a href=\"mailto:" + SiteUtil.escapeHtml(inner) + "\">" + SiteUtil.escapeHtml(inner) + "</a>")
                        i = close + 1
                        start = i
                        continue
                    }
                    let c = inner[0]
                    if c.isalpha() or c == "/" or c == "!" {
                        self.flushText(s, start, i, out)
                        out.push(s.slice(i, close + 1))
                        i = close + 1
                        start = i
                        continue
                    }
                }
                i += 1
                continue
            }

            if ch == "*" or ch == "_" or ch == "~" {
                let em = self.emphasisAt(s, i)
                if em != null {
                    self.flushText(s, start, i, out)
                    out.push(em["html"])
                    i = em["end"]
                    start = i
                    continue
                }
                let run = 0
                while i + run < n and s[i + run] == ch { run += 1 }
                i += run
                continue
            }

            if ch == "h" and (i == 0 or SiteUtil.isSpace(s[i - 1]) or s[i - 1] == "(") {
                let head = s.slice(i, i + 8)
                if head.startsWith("http://") or head == "https://" {
                    let k = i
                    while k < n and not SiteUtil.isSpace(s[k]) and s[k] != "<" { k += 1 }
                    while k > i and ".,:;!?)'\"".contains(s[k - 1]) { k -= 1 }
                    let url = s.slice(i, k)
                    self.flushText(s, start, i, out)
                    out.push("<a href=\"" + SiteUtil.escapeHtml(url) + "\">" + SiteUtil.escapeHtml(url) + "</a>")
                    i = k
                    start = i
                    continue
                }
            }

            i += 1
        }
        self.flushText(s, start, n, out)
        return out.join("")
    }

    fn flushText(s, start, stop, out) {
        if stop > start { out.push(SiteUtil.escapeHtml(s.slice(start, stop))) }
    }

    # Index of the bracket closing the one at s[open], honouring nesting and escapes.
    fn matching(s, open, opener, closer) {
        let depth = 0
        let k = open
        let n = len(s)
        while k < n {
            let c = s[k]
            if c == "\\" {
                k += 2
                continue
            }
            if c == "`" {
                let skip = SiteUtil.indexFrom(s, "`", k + 1)
                if skip < 0 { return -1 }
                k = skip + 1
                continue
            }
            if c == opener {
                depth += 1
            } else if c == closer {
                depth -= 1
                if depth == 0 { return k }
            }
            k += 1
        }
        return -1
    }

    # [text](url "title"), [text][ref], [text][] or [ref] -> {"text", "url", "title", "end"}
    fn linkAt(s, i) {
        let close = self.matching(s, i, "[", "]")
        if close < 0 { return null }
        let text = s.slice(i + 1, close)
        let n = len(s)
        if close + 1 < n and s[close + 1] == "(" {
            let paren = self.matching(s, close + 1, "(", ")")
            if paren < 0 { return null }
            let dest = self.destination(s.slice(close + 2, paren))
            return {"text": text, "url": dest["url"], "title": dest["title"], "end": paren + 1}
        }
        let label = text
        let end = close + 1
        if close + 1 < n and s[close + 1] == "[" {
            let close2 = SiteUtil.indexFrom(s, "]", close + 2)
            if close2 < 0 { return null }
            let given = s.slice(close + 2, close2)
            if given != "" { label = given }
            end = close2 + 1
        }
        let key = SiteUtil.collapseSpaces(label).lower()
        if key in self.refs {
            let ref = self.refs[key]
            return {"text": text, "url": ref["url"], "title": ref["title"], "end": end}
        }
        return null
    }

    # **strong**, __strong__, *em*, _em_, ~~strike~~ at s[i] -> {"html", "end"} or null
    fn emphasisAt(s, i) {
        let n = len(s)
        let ch = s[i]
        let run = 0
        while i + run < n and s[i + run] == ch { run += 1 }
        if i + run >= n or SiteUtil.isSpace(s[i + run]) { return null }
        if ch == "_" and i > 0 and SiteUtil.isWordChar(s[i - 1]) { return null }

        if ch == "~" {
            if run != 2 { return null }
            let close = self.closingRun(s, ch, 2, i + 2)
            if close < 0 { return null }
            return {"html": "<del>" + self.inline(s.slice(i + 2, close)) + "</del>", "end": close + 2}
        }

        if run >= 3 {
            let close3 = self.closingRun(s, ch, 3, i + 3)
            if close3 >= 0 {
                let body = self.inline(s.slice(i + 3, close3))
                return {"html": "<em><strong>" + body + "</strong></em>", "end": close3 + 3}
            }
        }
        if run >= 2 {
            let close2 = self.closingRun(s, ch, 2, i + 2)
            if close2 >= 0 {
                return {"html": "<strong>" + self.inline(s.slice(i + 2, close2)) + "</strong>", "end": close2 + 2}
            }
        }
        let close1 = self.closingRun(s, ch, 1, i + 1)
        if close1 >= 0 {
            return {"html": "<em>" + self.inline(s.slice(i + 1, close1)) + "</em>", "end": close1 + 1}
        }
        return null
    }

    # Start of the next run of exactly `size` delimiter chars that can close
    # (not preceded by whitespace; for "_", not followed by a word character).
    fn closingRun(s, ch, size, startAt) {
        let n = len(s)
        let k = startAt
        while k < n {
            let c = s[k]
            if c == "`" {
                let skip = SiteUtil.indexFrom(s, "`", k + 1)
                if skip < 0 { return -1 }
                k = skip + 1
                continue
            }
            if c == "\\" {
                k += 2
                continue
            }
            if c == ch {
                let run = 0
                while k + run < n and s[k + run] == ch { run += 1 }
                let after = k + run < n ? s[k + run] : ""
                let okBefore = k > startAt and not SiteUtil.isSpace(s[k - 1])
                let okAfter = ch != "_" or not SiteUtil.isWordChar(after)
                if run == size and okBefore and okAfter { return k }
                k += run
                continue
            }
            k += 1
        }
        return -1
    }
}

Markdown = __QMarkdown()

# ── module: ./src/template.sa (src/template.sa) ──
# quantum-site / template — a Handlebars-style template engine
#
#   Template.render("<h1>{{ title | upper }}</h1>", {"title": "hi"})   # <h1>HI</h1>
#
#   {{ page.title }}              value, HTML-escaped
#   {{{ content }}}               value, raw (no escaping)
#   {{ post.date | date "short" }} filters, chained with |
#   {{#if page.tags}} ... {{else if page.draft}} ... {{else}} ... {{/if}}
#   {{#unless page.hideTitle}} ... {{/unless}}
#   {{#each site.posts}} {{ @index }} {{ this.title }} or {{ title }} {{else}} none {{/each}}
#   {{#each site.posts as post}} {{ post.title }} {{/each}}
#   {{#with page.author}} {{ name }} {{/with}}
#   {{#if page.layout == "post"}} ... {{/if}}      == != and `not` in conditions
#   {{> header}}  {{> card post}}                  partials (optionally with a new context)
#   {{! a comment }}   \{{ literal braces   {{~ trims whitespace ~}}
#
# Inside #each: @index (from 0), @number (from 1), @first, @last, @key (dicts).
# @root is the data passed to render(). Names are looked up from the innermost
# context outwards, so {{ site.title }} works inside any block.
#
# Exposes the global: Template

# @use ./util.sa
# @use ./markdown.sa

class __QTemplate {
    fn init() {
        self.partials = {}
        self.custom = {}
        self.MAX_DEPTH = 40
    }

    # ── public API ───────────────────────────────────────────────────────

    fn render(source, data) {
        return self.renderCompiled(self.compile(source, "template"), data)
    }

    fn compile(source, name) {
        if name == null { name = "template" }
        let src = SiteUtil.normalizeNewlines(source)
        let tokens = self.tokenize(src, name)
        return {"name": name, "nodes": self.parseTokens(tokens, src, name)}
    }

    fn renderCompiled(compiled, data) {
        if data == null { data = {} }
        let scopes = [{"ctx": data, "locals": {}}]
        let out = []
        self.renderNodes(compiled["nodes"], scopes, out, 0, compiled["name"])
        return out.join("")
    }

    fn registerPartial(name, source) {
        self.partials[name] = self.compile(source, "partial " + name)
    }

    fn hasPartial(name) {
        return name in self.partials
    }

    fn clearPartials() {
        self.partials = {}
    }

    # fn(value, args) -> new value. Used as {{ x | name arg1 arg2 }}.
    fn addFilter(name, handler) {
        self.custom[name] = handler
    }

    # ── tokenizer ────────────────────────────────────────────────────────

    fn tokenize(src, name) {
        let tokens = []
        let pos = 0
        let n = len(src)
        let trimNext = false
        while pos < n {
            let openAt = SiteUtil.indexFrom(src, "{{", pos)
            if openAt < 0 {
                self.pushText(tokens, src.slice(pos), trimNext)
                break
            }
            # \{{ -> literal {{
            if openAt > 0 and src[openAt - 1] == "\\" {
                self.pushText(tokens, src.slice(pos, openAt - 1) + "{{", trimNext)
                trimNext = false
                pos = openAt + 2
                continue
            }
            let rawTag = openAt + 2 < n and src[openAt + 2] == "{"
            let closer = rawTag ? "}}}" : "}}"
            let bodyStart = openAt + (rawTag ? 3 : 2)
            let close = SiteUtil.indexFrom(src, closer, bodyStart)
            if close < 0 {
                raise "Template " + name + ", line " + SiteUtil.text(self.lineAt(src, openAt)) + ": unclosed " + (rawTag ? "{{{" : "{{")
            }
            self.pushText(tokens, src.slice(pos, openAt), trimNext)
            trimNext = false
            let inner = src.slice(bodyStart, close)
            pos = close + len(closer)
            if inner.startsWith("~") {
                inner = inner.slice(1)
                self.trimLastText(tokens)
            }
            if inner.endsWith("~") {
                inner = inner.slice(0, len(inner) - 1)
                trimNext = true
            }
            inner = inner.trim()
            if rawTag {
                tokens.push({"k": "var", "raw": true, "src": inner, "at": openAt})
                continue
            }
            if inner.startsWith("!") { continue }
            if inner.startsWith("#") {
                let body = inner.slice(1).trim()
                let space = body.indexOf(" ")
                let blockName = space < 0 ? body : body.slice(0, space)
                let arg = space < 0 ? "" : body.slice(space + 1).trim()
                tokens.push({"k": "open", "name": blockName, "src": arg, "at": openAt})
            } else if inner.startsWith("/") {
                tokens.push({"k": "close", "name": inner.slice(1).trim(), "at": openAt})
            } else if inner == "else" or inner.startsWith("else ") {
                tokens.push({"k": "else", "src": inner.slice(4).trim(), "at": openAt})
            } else if inner.startsWith(">") {
                let body = inner.slice(1).trim()
                let space = body.indexOf(" ")
                let partName = space < 0 ? body : body.slice(0, space)
                let arg = space < 0 ? "" : body.slice(space + 1).trim()
                tokens.push({"k": "partial", "name": partName, "src": arg, "at": openAt})
            } else {
                tokens.push({"k": "var", "raw": false, "src": inner, "at": openAt})
            }
        }
        return tokens
    }

    fn pushText(tokens, text, trimStart) {
        let t = text
        if trimStart { t = self.trimStartText(t) }
        if t != "" { tokens.push({"k": "text", "v": t}) }
    }

    fn trimStartText(t) {
        let k = 0
        while k < len(t) and SiteUtil.isSpace(t[k]) { k += 1 }
        return t.slice(k)
    }

    fn trimLastText(tokens) {
        if len(tokens) == 0 { return }
        let last = tokens[len(tokens) - 1]
        if last["k"] == "text" {
            last["v"] = SiteUtil.trimEnd(last["v"])
            if last["v"] == "" { tokens.pop() }
        }
    }

    fn lineAt(src, pos) {
        let line = 1
        let k = 0
        while k < pos and k < len(src) {
            if src[k] == "\n" { line += 1 }
            k += 1
        }
        return line
    }

    fn fail(src, name, at, message) {
        raise "Template " + name + ", line " + SiteUtil.text(self.lineAt(src, at)) + ": " + message
    }

    # ── parser: tokens -> node tree ──────────────────────────────────────

    fn parseTokens(tokens, src, name) {
        let root = []
        let stack = [{"node": null, "list": root, "name": ""}]
        for tok in tokens {
            let frame = stack[len(stack) - 1]
            let k = tok["k"]
            if k == "text" {
                frame["list"].push({"t": "text", "v": tok["v"]})
            } else if k == "var" {
                frame["list"].push({"t": "var", "raw": tok["raw"], "e": self.compileExpr(tok["src"], src, name, tok["at"])})
            } else if k == "partial" {
                let arg = tok["src"] == "" ? null : self.compileExpr(tok["src"], src, name, tok["at"])
                frame["list"].push({"t": "partial", "name": tok["name"], "e": arg, "at": tok["at"]})
            } else if k == "open" {
                let block = tok["name"]
                let node = null
                let target = null
                if block == "if" or block == "unless" {
                    if tok["src"] == "" { self.fail(src, name, tok["at"], "{{#" + block + "}} needs a condition") }
                    let branch = {"cond": self.compileExpr(tok["src"], src, name, tok["at"]), "negate": block == "unless", "body": []}
                    node = {"t": "if", "branches": [branch], "alt": []}
                    target = branch["body"]
                } else if block == "each" or block == "with" {
                    if tok["src"] == "" { self.fail(src, name, tok["at"], "{{#" + block + "}} needs a value") }
                    let exprSrc = tok["src"]
                    let alias = null
                    let asAt = exprSrc.indexOf(" as ")
                    if asAt > 0 {
                        alias = exprSrc.slice(asAt + 4).trim().replaceAll("|", "").trim()
                        exprSrc = exprSrc.slice(0, asAt).trim()
                    }
                    node = {"t": block, "e": self.compileExpr(exprSrc, src, name, tok["at"]), "alias": alias, "body": [], "alt": []}
                    target = node["body"]
                } else {
                    self.fail(src, name, tok["at"], "unknown block {{#" + block + "}} (use if, unless, each or with)")
                }
                frame["list"].push(node)
                stack.push({"node": node, "list": target, "name": block})
            } else if k == "else" {
                if len(stack) == 1 { self.fail(src, name, tok["at"], "{{else}} outside a block") }
                let node = frame["node"]
                let rest = tok["src"]
                if rest.startsWith("if ") and node["t"] == "if" {
                    let branch = {"cond": self.compileExpr(rest.slice(3).trim(), src, name, tok["at"]), "negate": false, "body": []}
                    node["branches"].push(branch)
                    frame["list"] = branch["body"]
                } else {
                    frame["list"] = node["alt"]
                }
            } else if k == "close" {
                if len(stack) == 1 { self.fail(src, name, tok["at"], "{{/" + tok["name"] + "}} without an opening block") }
                if frame["name"] != tok["name"] {
                    self.fail(src, name, tok["at"], "{{/" + tok["name"] + "}} closes {{#" + frame["name"] + "}}")
                }
                stack.pop()
            }
        }
        if len(stack) > 1 {
            raise "Template " + name + ": {{#" + stack[len(stack) - 1]["name"] + "}} is never closed"
        }
        return root
    }

    # ── expressions ──────────────────────────────────────────────────────

    fn compileExpr(source, src, name, at) {
        let s = source.trim()
        if s == "" { self.fail(src, name, at, "empty {{ }}") }
        if s.startsWith("not ") {
            return {"kind": "not", "a": self.compileExpr(s.slice(4), src, name, at)}
        }
        let orAt = self.findTop(s, " or ")
        if orAt > 0 {
            return {"kind": "or", "a": self.compileExpr(s.slice(0, orAt), src, name, at), "b": self.compileExpr(s.slice(orAt + 4), src, name, at)}
        }
        let andAt = self.findTop(s, " and ")
        if andAt > 0 {
            return {"kind": "and", "a": self.compileExpr(s.slice(0, andAt), src, name, at), "b": self.compileExpr(s.slice(andAt + 5), src, name, at)}
        }
        for op in [" == ", " != "] {
            let k = self.findTop(s, op)
            if k > 0 {
                return {"kind": "cmp", "op": op.trim(), "a": self.compileExpr(s.slice(0, k), src, name, at), "b": self.compileExpr(s.slice(k + 4), src, name, at)}
            }
        }
        let parts = self.topParts(s, "|")
        let value = self.compileOperand(parts[0].trim())
        if len(parts) == 1 { return value }
        let filters = []
        for pi in range(1, len(parts)) {
            let words = self.argWords(parts[pi].trim())
            if len(words) == 0 { self.fail(src, name, at, "empty filter in {{ " + s + " }}") }
            let args = []
            for j in range(1, len(words)) { args.push(self.compileOperand(words[j])) }
            filters.push({"name": words[0], "args": args})
        }
        return {"kind": "pipe", "value": value, "filters": filters}
    }

    fn compileOperand(tok) {
        let t = tok.trim()
        if len(t) >= 2 and (t[0] == "\"" or t[0] == "'") and t[len(t) - 1] == t[0] {
            return {"kind": "lit", "v": t.slice(1, len(t) - 1)}
        }
        if t == "true" { return {"kind": "lit", "v": true} }
        if t == "false" { return {"kind": "lit", "v": false} }
        if t == "null" or t == "nil" { return {"kind": "lit", "v": null} }
        if self.isNumber(t) { return {"kind": "lit", "v": num(t)} }
        let parts = []
        if t != "this" and t != "." {
            for seg in t.split(".") {
                if seg != "" { parts.push(seg) }
            }
        }
        if t.startsWith("this.") { parts = parts.slice(1) }
        return {"kind": "path", "parts": parts}
    }

    fn isNumber(t) {
        if t == "" { return false }
        let first = t[0] == "-" ? 1 : 0
        if first == len(t) { return false }
        let dots = 0
        for k in range(first, len(t)) {
            if t[k] == "." {
                dots += 1
            } else if not t[k].isdigit() {
                return false
            }
        }
        return dots <= 1
    }

    # Index of `needle` outside quotes, or -1.
    fn findTop(s, needle) {
        let quote = ""
        let k = 0
        let n = len(s)
        let m = len(needle)
        while k < n {
            let c = s[k]
            if quote != "" {
                if c == quote { quote = "" }
            } else if c == "\"" or c == "'" {
                quote = c
            } else if s.slice(k, k + m) == needle {
                return k
            }
            k += 1
        }
        return -1
    }

    # Pieces of `s` between `sep` characters that are outside quotes.
    fn topParts(s, sep) {
        let parts = []
        let cur = []
        let quote = ""
        for k in range(len(s)) {
            let c = s[k]
            if quote != "" {
                cur.push(c)
                if c == quote { quote = "" }
            } else if c == "\"" or c == "'" {
                quote = c
                cur.push(c)
            } else if c == sep {
                parts.push(cur.join(""))
                cur = []
            } else {
                cur.push(c)
            }
        }
        parts.push(cur.join(""))
        return parts
    }

    # Whitespace-separated words; quoted strings stay whole.
    fn argWords(s) {
        let words = []
        let cur = []
        let quote = ""
        for k in range(len(s)) {
            let c = s[k]
            if quote != "" {
                cur.push(c)
                if c == quote { quote = "" }
            } else if c == "\"" or c == "'" {
                quote = c
                cur.push(c)
            } else if c == " " or c == "\t" {
                if len(cur) > 0 {
                    words.push(cur.join(""))
                    cur = []
                }
            } else {
                cur.push(c)
            }
        }
        if len(cur) > 0 { words.push(cur.join("")) }
        return words
    }

    # ── evaluation ───────────────────────────────────────────────────────

    fn evaluate(e, scopes) {
        let kind = e["kind"]
        if kind == "lit" { return e["v"] }
        if kind == "path" { return self.lookup(scopes, e["parts"]) }
        if kind == "not" { return not self.truthy(self.evaluate(e["a"], scopes)) }
        if kind == "and" { return self.truthy(self.evaluate(e["a"], scopes)) and self.truthy(self.evaluate(e["b"], scopes)) }
        if kind == "or" {
            let left = self.evaluate(e["a"], scopes)
            if self.truthy(left) { return left }
            return self.evaluate(e["b"], scopes)
        }
        if kind == "cmp" {
            let same = self.sameValue(self.evaluate(e["a"], scopes), self.evaluate(e["b"], scopes))
            return e["op"] == "==" ? same : not same
        }
        let v = self.evaluate(e["value"], scopes)
        for f in e["filters"] {
            let args = []
            for a in f["args"] { args.push(self.evaluate(a, scopes)) }
            v = self.applyFilter(f["name"], v, args, scopes)
        }
        return v
    }

    fn sameValue(a, b) {
        if a == null or b == null { return a == null and b == null }
        if type(a) == type(b) and (type(a) == "string" or type(a) == "number" or type(a) == "bool") { return a == b }
        return SiteUtil.text(a) == SiteUtil.text(b)
    }

    fn lookup(scopes, parts) {
        let top = scopes[len(scopes) - 1]
        if len(parts) == 0 { return top["ctx"] }
        let first = parts[0]
        let v = null
        if first == "@root" {
            v = scopes[0]["ctx"]
        } else if first.startsWith("@") {
            let k = len(scopes) - 1
            while k >= 0 {
                if first in scopes[k]["locals"] {
                    v = scopes[k]["locals"][first]
                    break
                }
                k -= 1
            }
        } else {
            let found = false
            let k = len(scopes) - 1
            while k >= 0 and not found {
                let frame = scopes[k]
                if first in frame["locals"] {
                    v = frame["locals"][first]
                    found = true
                } else if type(frame["ctx"]) == "dict" and first in frame["ctx"] {
                    v = frame["ctx"][first]
                    found = true
                }
                k -= 1
            }
            if not found { return null }
        }
        for j in range(1, len(parts)) {
            v = self.member(v, parts[j])
            if v == null { return null }
        }
        return v
    }

    fn member(v, key) {
        let t = type(v)
        if t == "dict" { return v.get(key, null) }
        if t == "array" {
            if key == "length" or key == "size" { return len(v) }
            if key == "first" { return len(v) > 0 ? v[0] : null }
            if key == "last" { return len(v) > 0 ? v[len(v) - 1] : null }
            if SiteUtil.digitsOnly(key) {
                let idx = num(key)
                return idx < len(v) ? v[idx] : null
            }
            return null
        }
        if t == "string" and (key == "length" or key == "size") { return len(v) }
        return null
    }

    fn truthy(v) {
        if v == null { return false }
        let t = type(v)
        if t == "bool" { return v }
        if t == "number" { return v != 0 }
        if t == "string" { return v != "" }
        if t == "array" { return len(v) > 0 }
        if t == "dict" { return len(v.keys()) > 0 }
        return true
    }

    fn display(v) {
        if v == null { return "" }
        let t = type(v)
        if t == "array" {
            let parts = []
            for x in v { parts.push(self.display(x)) }
            return parts.join(", ")
        }
        if t == "bool" { return v ? "true" : "false" }
        if t == "dict" { return JSON.stringify(v) }
        return SiteUtil.text(v)
    }

    # ── filters ──────────────────────────────────────────────────────────

    fn arg(args, k, fallback) {
        if k < len(args) and args[k] != null { return args[k] }
        return fallback
    }

    fn applyFilter(name, v, args, scopes) {
        if name in self.custom {
            let handler = self.custom[name]
            return handler(v, args)
        }
        if name == "upper" { return self.display(v).upper() }
        if name == "lower" { return self.display(v).lower() }
        if name == "capitalize" {
            let s = self.display(v)
            return s == "" ? s : s[0].upper() + s.slice(1)
        }
        if name == "trim" { return self.display(v).trim() }
        if name == "default" { return self.truthy(v) ? v : self.arg(args, 0, "") }
        if name == "date" { return SiteUtil.formatDate(v, self.arg(args, 0, "long")) }
        if name == "slug" or name == "slugify" { return SiteUtil.slugify(self.display(v)) }
        if name == "truncate" { return SiteUtil.truncateChars(self.display(v), self.arg(args, 0, 100)) }
        if name == "words" { return SiteUtil.truncateWords(self.display(v), self.arg(args, 0, 30)) }
        if name == "striptags" { return SiteUtil.stripTags(self.display(v)) }
        if name == "escape" or name == "xml" { return SiteUtil.escapeHtml(self.display(v)) }
        if name == "markdown" { return Markdown.render(self.display(v)) }
        if name == "inline" { return Markdown.renderInline(self.display(v)) }
        if name == "json" { return JSON.stringify(v) }
        if name == "wordcount" { return SiteUtil.wordCount(self.display(v)) }
        if name == "length" or name == "size" or name == "count" {
            let t = type(v)
            if t == "array" or t == "string" { return len(v) }
            if t == "dict" { return len(v.keys()) }
            return 0
        }
        if name == "join" {
            if type(v) != "array" { return self.display(v) }
            let parts = []
            for x in v { parts.push(self.display(x)) }
            return parts.join(self.arg(args, 0, ", "))
        }
        if name == "first" { return self.member(v, "first") }
        if name == "last" { return self.member(v, "last") }
        if name == "limit" {
            if type(v) != "array" { return v }
            return v.slice(0, self.arg(args, 0, len(v)))
        }
        if name == "offset" {
            if type(v) != "array" { return v }
            return v.slice(self.arg(args, 0, 0))
        }
        if name == "reverse" {
            if type(v) == "array" {
                let out = []
                let k = len(v) - 1
                while k >= 0 {
                    out.push(v[k])
                    k -= 1
                }
                return out
            }
            let s = self.display(v)
            let chars = []
            let k = len(s) - 1
            while k >= 0 {
                chars.push(s[k])
                k -= 1
            }
            return chars.join("")
        }
        if name == "sort" {
            if type(v) != "array" { return v }
            let field = self.arg(args, 0, "")
            let desc = self.arg(args, 1, "") == "desc"
            if field == "" {
                let ordered = SiteUtil.sortStrings(v)
                return desc ? self.applyFilter("reverse", ordered, [], scopes) : ordered
            }
            return SiteUtil.sortRecords(v, field, desc)
        }
        if name == "where" {
            if type(v) != "array" { return [] }
            let field = self.arg(args, 0, "")
            let want = self.arg(args, 1, true)
            let out = []
            for item in v {
                if type(item) == "dict" {
                    let have = item.get(field, null)
                    if type(have) == "array" {
                        for h in have {
                            if self.sameValue(h, want) {
                                out.push(item)
                                break
                            }
                        }
                    } else if self.sameValue(have, want) {
                        out.push(item)
                    }
                }
            }
            return out
        }
        if name == "plus" { return num(self.display(v)) + self.arg(args, 0, 1) }
        if name == "minus" { return num(self.display(v)) - self.arg(args, 0, 1) }
        if name == "append" { return self.display(v) + self.display(self.arg(args, 0, "")) }
        if name == "prepend" { return self.display(self.arg(args, 0, "")) + self.display(v) }
        if name == "replace" { return self.display(v).replaceAll(self.display(self.arg(args, 0, "")), self.display(self.arg(args, 1, ""))) }
        if name == "plural" {
            let count = type(v) == "array" ? len(v) : v
            return count == 1 ? self.arg(args, 0, "") : self.arg(args, 1, self.display(self.arg(args, 0, "")) + "s")
        }
        if name == "rel" {
            let url = self.display(v)
            if url.startsWith("http://") or url.startsWith("https://") or url.startsWith("#") or url.startsWith("mailto:") { return url }
            if url.startsWith("/") { url = url.slice(1) }
            let root = self.lookup(scopes, ["page", "root"])
            if root == null { root = "" }
            if url == "" or url == "index.html" { return root == "" ? "index.html" : root + "index.html" }
            return root + url
        }
        if name == "abs" {
            let base = self.display(self.lookup(scopes, ["site", "baseUrl"]))
            let url = self.display(v)
            if url.startsWith("http://") or url.startsWith("https://") { return url }
            if base == "" { return url }
            if base.endsWith("/") { base = base.slice(0, len(base) - 1) }
            if url.startsWith("/") { url = url.slice(1) }
            return base + "/" + url
        }
        raise "unknown template filter '" + name + "'"
    }

    # ── rendering ────────────────────────────────────────────────────────

    fn renderNodes(nodes, scopes, out, depth, name) {
        if depth > self.MAX_DEPTH { raise "Template " + name + ": partials nested too deeply (a partial including itself?)" }
        for node in nodes {
            let t = node["t"]
            if t == "text" {
                out.push(node["v"])
            } else if t == "var" {
                let v = self.evaluate(node["e"], scopes)
                if node["raw"] {
                    out.push(self.display(v))
                } else {
                    out.push(SiteUtil.escapeHtml(self.display(v)))
                }
            } else if t == "if" {
                let matched = false
                for b in node["branches"] {
                    let ok = self.truthy(self.evaluate(b["cond"], scopes))
                    if b["negate"] { ok = not ok }
                    if ok {
                        self.renderNodes(b["body"], scopes, out, depth, name)
                        matched = true
                        break
                    }
                }
                if not matched { self.renderNodes(node["alt"], scopes, out, depth, name) }
            } else if t == "each" {
                self.renderEach(node, scopes, out, depth, name)
            } else if t == "with" {
                let v = self.evaluate(node["e"], scopes)
                if self.truthy(v) {
                    let locals = {}
                    if node["alias"] != null { locals[node["alias"]] = v }
                    scopes.push({"ctx": v, "locals": locals})
                    self.renderNodes(node["body"], scopes, out, depth, name)
                    scopes.pop()
                } else {
                    self.renderNodes(node["alt"], scopes, out, depth, name)
                }
            } else if t == "partial" {
                if not (node["name"] in self.partials) {
                    raise "Template " + name + ": unknown partial '" + node["name"] + "' (add layouts/partials/" + node["name"] + ".html)"
                }
                let part = self.partials[node["name"]]
                if node["e"] != null {
                    scopes.push({"ctx": self.evaluate(node["e"], scopes), "locals": {}})
                    self.renderNodes(part["nodes"], scopes, out, depth + 1, part["name"])
                    scopes.pop()
                } else {
                    self.renderNodes(part["nodes"], scopes, out, depth + 1, part["name"])
                }
            }
        }
    }

    fn renderEach(node, scopes, out, depth, name) {
        let v = self.evaluate(node["e"], scopes)
        let alias = node["alias"]
        let t = type(v)
        if t == "array" and len(v) > 0 {
            let n = len(v)
            for k in range(n) {
                let locals = {"@index": k, "@number": k + 1, "@first": k == 0, "@last": k == n - 1}
                if alias != null { locals[alias] = v[k] }
                scopes.push({"ctx": alias == null ? v[k] : scopes[len(scopes) - 1]["ctx"], "locals": locals})
                self.renderNodes(node["body"], scopes, out, depth, name)
                scopes.pop()
            }
            return
        }
        if t == "dict" and len(v.keys()) > 0 {
            let keys = SiteUtil.sortStrings(v.keys())
            let n = len(keys)
            for k in range(n) {
                let key = keys[k]
                let locals = {"@index": k, "@number": k + 1, "@first": k == 0, "@last": k == n - 1, "@key": key}
                if alias != null { locals[alias] = v[key] }
                scopes.push({"ctx": alias == null ? v[key] : scopes[len(scopes) - 1]["ctx"], "locals": locals})
                self.renderNodes(node["body"], scopes, out, depth, name)
                scopes.pop()
            }
            return
        }
        self.renderNodes(node["alt"], scopes, out, depth, name)
    }
}

Template = __QTemplate()

# ── module: ./src/site.sa (src/site.sa) ──
# quantum-site / site — builds a folder of Markdown + layouts into a static website
#
#   let report = Site.build({"root": "."})        # reads ./site.json, writes ./public
#   print(Site.summary(report))
#
# Folder layout (every folder name can be changed in site.json):
#
#   site.json                 title, description, baseUrl, nav, params, ...
#   content/                  pages: .md (Markdown) or .html (template) files
#     about.md                -> public/about.html
#     posts/2026-11-02-hi.md  -> public/posts/hi.html   (a blog post, dated from the name)
#     images/logo.png         -> copied as is
#   layouts/                  page, post, index, tag, tags, archive, 404 (.html templates)
#     partials/header.html    {{> header}}
#   static/                   copied to the output root (CSS, images, favicon, ...)
#
# Also generated: index.html (if content/ has none), tags/<tag>.html, tags/index.html,
# archive.html, 404.html (each only when its layout exists), feed.xml (RSS),
# sitemap.xml (needs baseUrl) and .nojekyll (for GitHub Pages).
#
# Exposes the global: Site

# @use ./util.sa
# @use ./frontmatter.sa
# @use ./markdown.sa
# @use ./template.sa

class __QSite {
    fn init() {
        self.VERSION = "1.0.0"
        self.CONFIG_FILE = "site.json"
    }

    fn defaults() {
        return {
            "title": "My Quantum Site",
            "description": "",
            "author": "",
            "baseUrl": "",
            "language": "en",
            "contentDir": "content",
            "layoutsDir": "layouts",
            "staticDir": "static",
            "outDir": "public",
            "postsDir": "posts",
            "drafts": false,
            "feed": true,
            "feedItems": 20,
            "sitemap": true,
            "tagPages": true,
            "summaryWords": 40,
            "recentPosts": 5,
            "nav": [],
            "params": {}
        }
    }

    # ── configuration ────────────────────────────────────────────────────

    fn loadConfig(root) {
        let cfg = self.defaults()
        let path = SiteUtil.joinPath(root, self.CONFIG_FILE)
        if not os.path.exists(path) { return cfg }
        let raw = SiteUtil.normalizeNewlines(SiteUtil.readText(path))
        let parsed = null
        let problem = ""
        try {
            parsed = JSON.parse(raw)
        } catch (e) {
            problem = str(e)
        }
        if problem != "" { raise "site.json is not valid JSON: " + problem }
        if type(parsed) != "dict" { raise "site.json must contain a JSON object { ... }" }
        return SiteUtil.merge(cfg, parsed)
    }

    # ── build ────────────────────────────────────────────────────────────

    # options: "root" (default "."), "drafts", "outDir", "config" (dict merged over site.json)
    fn build(options) {
        if options == null { options = {} }
        SiteUtil.liftStepLimit()
        let root = options.get("root", ".")
        let cfg = SiteUtil.merge(self.loadConfig(root), options.get("config", {}))
        if "drafts" in options { cfg["drafts"] = options["drafts"] }
        if "outDir" in options { cfg["outDir"] = options["outDir"] }

        let report = {"pages": 0, "posts": 0, "tags": 0, "assets": 0, "files": [], "warnings": [], "seen": {},
            "outDir": SiteUtil.joinPath(root, cfg["outDir"])}
        let contentDir = SiteUtil.joinPath(root, cfg["contentDir"])
        if not os.path.isdir(contentDir) {
            raise "no '" + cfg["contentDir"] + "' folder in " + os.path.abspath(root) + ". Run `quantum-site init` to create a starter site."
        }
        let outDir = report["outDir"]
        SiteUtil.ensureDir(outDir)

        let layouts = self.loadLayouts(SiteUtil.joinPath(root, cfg["layoutsDir"]))
        let pages = []
        let assets = []
        for rel in SiteUtil.listFiles(contentDir) {
            let ext = SiteUtil.extOf(rel)
            if ext == ".md" or ext == ".markdown" or ext == ".html" or ext == ".htm" {
                let page = self.loadPage(contentDir, rel, cfg)
                if page != null { pages.push(page) }
            } else {
                assets.push(rel)
            }
        }

        let col = self.collect(pages, cfg)
        let site = self.siteData(cfg, col)
        report["posts"] = len(col["posts"])
        report["tags"] = len(col["tags"])

        let written = {}
        for page in pages {
            self.renderPage(page, site, layouts, outDir, report)
            written[page["url"]] = true
        }
        self.renderGenerated(site, col, layouts, outDir, report, written)

        if cfg["feed"] and len(col["posts"]) > 0 { self.writeFeed(site, col["posts"], cfg, outDir, report) }
        if cfg["sitemap"] {
            if SiteUtil.text(cfg["baseUrl"]) == "" {
                self.warn(report, "sitemap.xml skipped: set \"baseUrl\" in site.json (e.g. https://you.github.io/blog)")
            } else {
                self.writeSitemap(site, report, outDir)
            }
        }

        for rel in assets {
            SiteUtil.copyFile(SiteUtil.joinPath(contentDir, rel), SiteUtil.joinPath(outDir, rel))
            report["assets"] += 1
        }
        let staticDir = SiteUtil.joinPath(root, cfg["staticDir"])
        for rel in SiteUtil.listFiles(staticDir) {
            SiteUtil.copyFile(SiteUtil.joinPath(staticDir, rel), SiteUtil.joinPath(outDir, rel))
            report["assets"] += 1
        }
        SiteUtil.writeText(SiteUtil.joinPath(outDir, ".nojekyll"), "")
        return report
    }

    fn summary(report) {
        let lines = [
            "Built " + self.count(report["pages"], "page") + " (" + self.count(report["posts"], "post") + ", "
                + self.count(report["tags"], "tag") + ") and copied " + self.count(report["assets"], "file")
                + " into " + report["outDir"] + "/"
        ]
        for w in report["warnings"] { lines.push("  warning: " + w) }
        return lines.join("\n")
    }

    fn count(n, word) {
        return SiteUtil.text(n) + " " + word + (n == 1 ? "" : "s")
    }

    fn warn(report, message) {
        if message in report["seen"] { return }
        report["seen"][message] = true
        report["warnings"].push(message)
    }

    # ── layouts ──────────────────────────────────────────────────────────

    # {"post": {"tpl": compiled, "parent": "base"}, ...}; registers partials.
    fn loadLayouts(dir) {
        let layouts = {}
        Template.clearPartials()
        for rel in SiteUtil.listFiles(dir) {
            let ext = SiteUtil.extOf(rel)
            if ext != ".html" and ext != ".htm" and ext != ".xml" { continue }
            let name = SiteUtil.stripExt(rel)
            let source = SiteUtil.readText(SiteUtil.joinPath(dir, rel))
            if name.startsWith("partials/") {
                Template.registerPartial(name.slice(9), source)
                continue
            }
            let doc = FrontMatter.parse(source)
            layouts[name] = {
                "tpl": Template.compile(doc["body"], "layouts/" + rel),
                "parent": SiteUtil.text(doc["data"].get("layout", ""))
            }
        }
        return layouts
    }

    fn applyLayouts(content, page, site, layouts, report) {
        let name = self.layoutName(page.get("layout", "page"))
        let html = content
        let depth = 0
        while name != "" {
            if not (name in layouts) {
                if len(layouts.keys()) > 0 {
                    self.warn(report, "layout '" + name + "' not found (layouts/" + name + ".html), used by " + page["url"])
                }
                break
            }
            let lay = layouts[name]
            html = Template.renderCompiled(lay["tpl"], {"site": site, "page": page, "content": html})
            name = self.layoutName(lay["parent"])
            depth += 1
            if depth > 10 { raise "layouts nest too deeply (does '" + name + "' use itself?)" }
        }
        return html
    }

    fn layoutName(value) {
        if value == null or value == false { return "" }
        let s = SiteUtil.text(value).trim()
        if s == "none" or s == "false" { return "" }
        if s.endsWith(".html") { s = s.slice(0, len(s) - 5) }
        return s
    }

    # ── pages ────────────────────────────────────────────────────────────

    fn loadPage(contentDir, rel, cfg) {
        let doc = FrontMatter.parse(SiteUtil.readText(SiteUtil.joinPath(contentDir, rel)))
        let data = doc["data"]
        let body = doc["body"]
        if Template.truthy(data.get("draft", false)) and not cfg["drafts"] { return null }

        let ext = SiteUtil.extOf(rel)
        let isMarkdown = ext == ".md" or ext == ".markdown"
        let dir = SiteUtil.dirOf(rel)
        let file = SiteUtil.fileOf(SiteUtil.stripExt(rel))
        let date = SiteUtil.text(data.get("date", ""))
        let slug = file
        if len(file) > 11 and file[10] == "-" and SiteUtil.parseDate(file.slice(0, 10)) != null {
            if date == "" { date = file.slice(0, 10) }
            slug = file.slice(11)
        }
        if SiteUtil.text(data.get("slug", "")) != "" { slug = SiteUtil.slugify(data["slug"]) }

        let url = ""
        let permalink = SiteUtil.text(data.get("permalink", ""))
        if permalink != "" {
            url = SiteUtil.normalizePath(permalink)
            if url.startsWith("/") { url = url.slice(1) }
            if url == "" or url.endsWith("/") { url += "index.html" }
            if SiteUtil.extOf(url) == "" { url += ".html" }
        } else {
            url = SiteUtil.joinPath(dir, slug + ".html")
        }

        let section = dir
        let slash = dir.indexOf("/")
        if slash >= 0 { section = dir.slice(0, slash) }
        let isPost = section == cfg["postsDir"] and slug != "index"

        # A leading "# Title" becomes the title when front matter has none.
        let title = SiteUtil.text(data.get("title", ""))
        if title == "" and isMarkdown {
            let lines = body.split("\n")
            let k = 0
            while k < len(lines) and lines[k].trim() == "" { k += 1 }
            if k < len(lines) {
                let h = Markdown.headingOf(lines[k])
                if h != null and h["level"] == 1 {
                    title = SiteUtil.stripTags(Markdown.renderInline(h["text"]))
                    body = lines.slice(k + 1).join("\n")
                }
            }
        }
        if title == "" { title = url == "index.html" ? cfg["title"] : SiteUtil.titleFromSlug(slug) }

        let page = SiteUtil.copyDict(data)
        page["title"] = title
        page["date"] = date
        page["updated"] = SiteUtil.text(data.get("updated", ""))
        page["slug"] = slug
        page["url"] = url
        page["source"] = rel
        page["section"] = section
        page["isPost"] = isPost
        page["isHome"] = url == "index.html"
        page["root"] = SiteUtil.rootPrefix(url)
        page["tags"] = self.tagsOf(data.get("tags", []))
        page["layout"] = data.get("layout", isPost ? "post" : "page")
        page["body"] = body
        page["isTemplate"] = not isMarkdown
        if isMarkdown {
            page["content"] = Markdown.render(body)
            page["headings"] = Markdown.headings(body)
            page["toc"] = Markdown.toc(body, 2, 3)
        } else {
            page["content"] = body
            page["headings"] = []
            page["toc"] = ""
        }
        let words = SiteUtil.wordCount(isMarkdown ? SiteUtil.stripTags(page["content"]) : SiteUtil.stripTags(body))
        page["wordCount"] = words
        page["readingTime"] = words < 200 ? 1 : floor((words + 199) / 200)
        let given = SiteUtil.text(data.get("description", data.get("summary", "")))
        page["summary"] = given != "" ? given : self.summaryOf(page["content"], cfg["summaryWords"])
        return page
    }

    fn tagsOf(value) {
        let out = []
        let items = value
        if type(value) == "string" { items = value.split(",") }
        if type(items) != "array" { return out }
        for t in items {
            let s = SiteUtil.text(t).trim()
            if s != "" { out.push(s) }
        }
        return out
    }

    # Plain text of the first paragraph, cut to `count` words.
    fn summaryOf(html, count) {
        let pStart = html.indexOf("<p>")
        let text = html
        if pStart >= 0 {
            let pEnd = SiteUtil.indexFrom(html, "</p>", pStart)
            if pEnd > pStart { text = html.slice(pStart + 3, pEnd) }
        }
        return SiteUtil.truncateWords(SiteUtil.stripTags(text), count)
    }

    fn linkOf(page) {
        return {"title": page["title"], "url": page["url"], "date": page["date"]}
    }

    # ── collections: posts, pages, tags, years ───────────────────────────

    fn collect(pages, cfg) {
        let posts = []
        let others = []
        for p in pages {
            if p["isPost"] {
                posts.push(p)
            } else {
                others.push(p)
            }
        }
        posts = SiteUtil.sortRecords(posts, "date", true)
        let n = len(posts)
        let tagMap = {}
        for k in range(n) {
            let p = posts[k]
            p["newer"] = k > 0 ? self.linkOf(posts[k - 1]) : null
            p["older"] = k + 1 < n ? self.linkOf(posts[k + 1]) : null
            let links = []
            for t in p["tags"] {
                let slug = SiteUtil.slugify(t)
                if slug == "" { continue }
                if not (slug in tagMap) {
                    tagMap[slug] = {"name": t, "slug": slug, "url": "tags/" + slug + ".html", "posts": []}
                }
                tagMap[slug]["posts"].push(p)
                links.push({"name": t, "slug": slug, "url": "tags/" + slug + ".html"})
            }
            p["tagLinks"] = links
        }
        for p in others { p["tagLinks"] = [] }

        let tags = []
        for slug in SiteUtil.sortStrings(tagMap.keys()) {
            let t = tagMap[slug]
            t["count"] = len(t["posts"])
            tags.push(t)
        }

        let years = []
        let current = null
        for p in posts {
            let y = SiteUtil.formatDate(p["date"], "year")
            if y == "" { y = "Undated" }
            if current == null or current["year"] != y {
                current = {"year": y, "posts": []}
                years.push(current)
            }
            current["posts"].push(p)
        }
        return {"posts": posts, "pages": SiteUtil.sortRecords(others, "url", false), "tags": tags, "years": years}
    }

    fn siteData(cfg, col) {
        let site = SiteUtil.copyDict(cfg)
        let today = SiteUtil.today()
        site["posts"] = col["posts"]
        site["pages"] = col["pages"]
        site["tags"] = col["tags"]
        site["years"] = col["years"]
        site["recent"] = col["posts"].slice(0, cfg["recentPosts"])
        site["postCount"] = len(col["posts"])
        site["buildDate"] = today
        site["year"] = today.slice(0, 4)
        site["generator"] = "quantum-site " + self.VERSION
        return site
    }

    # ── rendering ────────────────────────────────────────────────────────

    fn renderPage(page, site, layouts, outDir, report) {
        let html = page["content"]
        if page["isTemplate"] {
            html = Template.renderCompiled(Template.compile(html, page["source"]), {"site": site, "page": page})
            page["content"] = html
        }
        self.writePage(page, html, site, layouts, outDir, report)
    }

    fn writePage(page, content, site, layouts, outDir, report) {
        let html = self.applyLayouts(content, page, site, layouts, report)
        SiteUtil.writeText(SiteUtil.joinPath(outDir, page["url"]), html)
        report["files"].push(page["url"])
        report["pages"] += 1
    }

    fn virtualPage(url, title, layout, extra) {
        let page = {
            "title": title, "url": url, "root": SiteUtil.rootPrefix(url), "layout": layout,
            "isHome": url == "index.html", "isPost": false, "content": "", "summary": "",
            "date": "", "tags": [], "tagLinks": [], "toc": "", "headings": [], "section": "", "source": ""
        }
        if extra != null {
            for k in extra.keys() { page[k] = extra[k] }
        }
        return page
    }

    fn renderGenerated(site, col, layouts, outDir, report, written) {
        let generated = []
        if not ("index.html" in written) {
            if "index" in layouts {
                generated.push(self.virtualPage("index.html", site["title"], "index",
                    {"posts": col["posts"], "summary": site["description"]}))
            } else {
                self.warn(report, "no home page: add content/index.md or layouts/index.html")
            }
        }
        if site["tagPages"] and "tag" in layouts {
            for t in col["tags"] {
                generated.push(self.virtualPage(t["url"], "Tagged \"" + t["name"] + "\"", "tag",
                    {"tag": t, "posts": t["posts"]}))
            }
        }
        if "tags" in layouts and not ("tags/index.html" in written) {
            generated.push(self.virtualPage("tags/index.html", "Tags", "tags", {"tagList": col["tags"]}))
        }
        if "archive" in layouts and not ("archive.html" in written) {
            generated.push(self.virtualPage("archive.html", "Archive", "archive", {"years": col["years"], "posts": col["posts"]}))
        }
        if "404" in layouts and not ("404.html" in written) {
            generated.push(self.virtualPage("404.html", "Page not found", "404", null))
        }
        for page in generated {
            self.writePage(page, "", site, layouts, outDir, report)
        }
    }

    # ── feed and sitemap ─────────────────────────────────────────────────

    fn absolute(base, url) {
        let b = SiteUtil.text(base)
        if b == "" { return url }
        if b.endsWith("/") { b = b.slice(0, len(b) - 1) }
        return b + "/" + url
    }

    fn writeFeed(site, posts, cfg, outDir, report) {
        let base = SiteUtil.text(cfg["baseUrl"])
        if base == "" { self.warn(report, "feed.xml links are relative: set \"baseUrl\" in site.json") }
        let lines = [
            "<?xml version=\"1.0\" encoding=\"UTF-8\"?>",
            "<rss version=\"2.0\" xmlns:atom=\"http://www.w3.org/2005/Atom\">",
            "<channel>",
            "  <title>" + SiteUtil.escapeHtml(site["title"]) + "</title>",
            "  <link>" + SiteUtil.escapeHtml(self.absolute(base, "")) + "</link>",
            "  <description>" + SiteUtil.escapeHtml(site["description"]) + "</description>",
            "  <language>" + SiteUtil.escapeHtml(site["language"]) + "</language>",
            "  <generator>" + SiteUtil.escapeHtml(site["generator"]) + "</generator>"
        ]
        if base != "" {
            lines.push("  <atom:link href=\"" + SiteUtil.escapeHtml(self.absolute(base, "feed.xml")) + "\" rel=\"self\" type=\"application/rss+xml\"/>")
        }
        if len(posts) > 0 and posts[0]["date"] != "" {
            lines.push("  <lastBuildDate>" + SiteUtil.formatDate(posts[0]["date"], "rfc822") + "</lastBuildDate>")
        }
        let limit = cfg["feedItems"]
        for k in range(len(posts)) {
            if k >= limit { break }
            let p = posts[k]
            let link = SiteUtil.escapeHtml(self.absolute(base, p["url"]))
            lines.push("  <item>")
            lines.push("    <title>" + SiteUtil.escapeHtml(p["title"]) + "</title>")
            lines.push("    <link>" + link + "</link>")
            lines.push("    <guid>" + link + "</guid>")
            if p["date"] != "" { lines.push("    <pubDate>" + SiteUtil.formatDate(p["date"], "rfc822") + "</pubDate>") }
            for t in p["tags"] { lines.push("    <category>" + SiteUtil.escapeHtml(t) + "</category>") }
            lines.push("    <description>" + SiteUtil.escapeHtml(p["summary"]) + "</description>")
            lines.push("  </item>")
        }
        lines.push("</channel>")
        lines.push("</rss>")
        SiteUtil.writeText(SiteUtil.joinPath(outDir, "feed.xml"), lines.join("\n") + "\n")
    }

    fn writeSitemap(site, report, outDir) {
        let base = site["baseUrl"]
        let lines = ["<?xml version=\"1.0\" encoding=\"UTF-8\"?>", "<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">"]
        for url in SiteUtil.sortStrings(report["files"]) {
            if url == "404.html" { continue }
            let loc = url == "index.html" ? self.absolute(base, "") : self.absolute(base, url)
            lines.push("  <url><loc>" + SiteUtil.escapeHtml(loc) + "</loc></url>")
        }
        lines.push("</urlset>")
        SiteUtil.writeText(SiteUtil.joinPath(outDir, "sitemap.xml"), lines.join("\n") + "\n")
    }

    # ── new post ─────────────────────────────────────────────────────────

    # Creates content/<postsDir>/YYYY-MM-DD-<slug>.md and returns its path.
    fn newPost(root, title, tags) {
        let cfg = self.loadConfig(root)
        let date = SiteUtil.today()
        let slug = SiteUtil.slugify(title)
        if slug == "" { raise "the post needs a title" }
        let path = SiteUtil.joinPath(SiteUtil.joinPath(root, cfg["contentDir"]), cfg["postsDir"] + "/" + date + "-" + slug + ".md")
        if os.path.exists(path) { raise path + " already exists" }
        let data = {"title": title, "date": date, "tags": tags == null ? [] : tags, "draft": false}
        let text = FrontMatter.stringify(data, ["title", "date", "tags", "draft"]) + "\nWrite your post here. **Markdown** works.\n"
        SiteUtil.writeText(path, text)
        return path
    }
}

Site = __QSite()

# ── module: ./src/starter.sa (src/starter.sa) ──
# quantum-site / starter — the starter site written by `quantum-site init`
#
#   SiteStarter.create("my-blog", {"title": "My Blog"})
#   # -> {"created": ["site.json", "layouts/base.html", ...], "skipped": []}
#
# Existing files are never overwritten. The file contents live in files() as
# lists of lines, so the package stays pure .sa.
#
# Exposes the global: SiteStarter

# @use ./util.sa

