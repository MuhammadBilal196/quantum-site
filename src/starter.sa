# quantum-site / starter — the starter site written by `quantum-site init`
#
#   SiteStarter.create("my-blog", {"title": "My Blog"})
#   # -> {"created": ["site.json", "layouts/base.html", ...], "skipped": []}
#
# Existing files are never overwritten. The file contents live in files() as
# lists of lines, so the package stays pure .sa.
#
# Exposes the global: SiteStarter

# @use ./util.sa

class __QSiteStarter {
    fn init() {}

    fn files() {
        let list = []
        list.push({"path": "site.json", "text": [
            "{",
            "  \"title\": \"My Quantum Site\",",
            "  \"description\": \"A fast static blog, built with the Quantum language and quantum-site.\",",
            "  \"author\": \"Your Name\",",
            "  \"baseUrl\": \"\",",
            "  \"language\": \"en\",",
            "  \"nav\": [",
            "    {\"title\": \"Home\", \"url\": \"index.html\"},",
            "    {\"title\": \"Archive\", \"url\": \"archive.html\"},",
            "    {\"title\": \"Tags\", \"url\": \"tags/index.html\"},",
            "    {\"title\": \"About\", \"url\": \"about.html\"}",
            "  ],",
            "  \"params\": {",
            "    \"github\": \"https://github.com/your-name\"",
            "  }",
            "}",
            ""
        ].join("\n")})
        list.push({"path": "content/about.md", "text": [
            "---",
            "title: About",
            "description: Who writes this site, and how it is built.",
            "---",
            "",
            "Hi! This site is generated by **quantum-site**, a static site generator written",
            "entirely in the [Quantum language](https://github.com/QuantumLogicsLabs/quantumlanguage).",
            "",
            "- Pages and posts are plain Markdown files in `content/`",
            "- The look comes from the templates in `layouts/` and the CSS in `static/`",
            "- `quantum-site build` turns everything into HTML in `public/`",
            "",
            "Edit `content/about.md` to tell visitors about yourself.",
            ""
        ].join("\n")})
        list.push({"path": "content/posts/2026-11-01-welcome.md", "text": [
            "---",
            "title: Welcome to your new site",
            "tags: [quantum, getting-started]",
            "---",
            "",
            "This is your first post. Every Markdown file in `content/posts/` becomes a blog post,",
            "and the date in the file name (`2026-11-01-welcome.md`) sets its date and order.",
            "",
            "## Writing a post",
            "",
            "Create a new post from the command line:",
            "",
            "```bash",
            "qrun quantum-site-cli.sa new \"My second post\"",
            "```",
            "",
            "or just add a file such as `content/posts/2026-12-25-holidays.md`:",
            "",
            "```markdown",
            "---",
            "title: Holidays",
            "tags: [life, travel]",
            "---",
            "",
            "Text in **Markdown**.",
            "```",
            "",
            "## Building the site",
            "",
            "```bash",
            "qrun quantum-site-cli.sa build",
            "```",
            "",
            "Open `public/index.html` in your browser. Links are relative, so the site works",
            "from a folder, from GitHub Pages or from any web server.",
            "",
            "> Tip: set `\"baseUrl\"` in `site.json` before you publish, so the RSS feed and the",
            "> sitemap contain full links.",
            ""
        ].join("\n")})
        list.push({"path": "content/posts/2026-11-02-markdown-cheatsheet.md", "text": [
            "---",
            "title: Markdown cheat sheet",
            "description: Everything quantum-site's Markdown renderer understands, on one page.",
            "tags: [markdown, quantum]",
            "---",
            "",
            "quantum-site supports CommonMark basics plus the GitHub extras people use every day.",
            "",
            "## Text",
            "",
            "You can write **bold**, *italic*, ***both***, ~~strikethrough~~ and `inline code`.",
            "Links look like [the Quantum language](https://github.com/QuantumLogicsLabs/quantumlanguage),",
            "and bare links work too: https://qpm.quantumlogicslimited.com",
            "",
            "## Lists",
            "",
            "1. Ordered lists",
            "2. With nesting",
            "   - like this",
            "   - and this",
            "3. Back to the top level",
            "",
            "- [x] Task lists",
            "- [ ] with checkboxes",
            "",
            "## Code",
            "",
            "```python",
            "fn greet(name) {",
            "    return \"Hello, \" + name + \"!\"",
            "}",
            "print(greet(\"Quantum\"))",
            "```",
            "",
            "## Tables",
            "",
            "| Feature        | Supported | Notes                 |",
            "|:---------------|:---------:|----------------------:|",
            "| Headings       | yes       | with anchor ids       |",
            "| Tables         | yes       | with alignment        |",
            "| Front matter   | yes       | title, date, tags ... |",
            "",
            "## Quotes",
            "",
            "> Simple things should be simple, complex things should be possible.",
            "",
            "---",
            "",
            "That's it. Check the source of this post in `content/posts/`.",
            ""
        ].join("\n")})
        list.push({"path": "layouts/404.html", "text": [
            "---",
            "layout: base",
            "---",
            "<article class=\"page center\">",
            "  <h1>404</h1>",
            "  <p class=\"lead\">This page doesn't exist.</p>",
            "  <p><a href=\"{{ \"index.html\" | abs }}\">Back to the home page</a></p>",
            "</article>",
            ""
        ].join("\n")})
        list.push({"path": "layouts/archive.html", "text": [
            "---",
            "layout: base",
            "---",
            "<article class=\"page\">",
            "  <h1>Archive</h1>",
            "  {{#each site.years}}",
            "  <h2>{{ year }}</h2>",
            "  <ul class=\"archive\">",
            "    {{#each posts}}<li><span class=\"meta\">{{ date | date \"short\" }}</span> <a href=\"{{ url | rel }}\">{{ title }}</a></li>",
            "    {{/each}}",
            "  </ul>",
            "  {{else}}",
            "  <p>No posts yet.</p>",
            "  {{/each}}",
            "</article>",
            ""
        ].join("\n")})
        list.push({"path": "layouts/base.html", "text": [
            "<!DOCTYPE html>",
            "<html lang=\"{{ site.language }}\">",
            "<head>",
            "  <meta charset=\"utf-8\">",
            "  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">",
            "  <title>{{#if page.isHome}}{{ site.title }}{{else}}{{ page.title }} · {{ site.title }}{{/if}}</title>",
            "  <meta name=\"description\" content=\"{{ page.summary | default site.description }}\">",
            "  <meta name=\"generator\" content=\"{{ site.generator }}\">",
            "  <link rel=\"stylesheet\" href=\"{{ \"style.css\" | rel }}\">",
            "  <link rel=\"alternate\" type=\"application/rss+xml\" title=\"{{ site.title }}\" href=\"{{ \"feed.xml\" | rel }}\">",
            "</head>",
            "<body>",
            "{{> header}}",
            "  <main class=\"container\">",
            "{{{ content }}}",
            "  </main>",
            "{{> footer}}",
            "</body>",
            "</html>",
            ""
        ].join("\n")})
        list.push({"path": "layouts/index.html", "text": [
            "---",
            "layout: base",
            "---",
            "<section class=\"hero\">",
            "  <h1>{{ site.title }}</h1>",
            "  {{#if site.description}}<p class=\"lead\">{{ site.description }}</p>{{/if}}",
            "</section>",
            "<section class=\"post-list\">",
            "{{#each site.posts}}",
            "{{> post-card}}",
            "{{else}}",
            "  <p>No posts yet. Run <code>quantum-site new \"My first post\"</code> to write one.</p>",
            "{{/each}}",
            "</section>",
            ""
        ].join("\n")})
        list.push({"path": "layouts/page.html", "text": [
            "---",
            "layout: base",
            "---",
            "<article class=\"page\">",
            "  <h1>{{ page.title }}</h1>",
            "{{{ content }}}",
            "</article>",
            ""
        ].join("\n")})
        list.push({"path": "layouts/partials/footer.html", "text": [
            "  <footer class=\"site-footer\">",
            "    <div class=\"container\">",
            "      <p>© {{ site.year }} {{ site.author }} · Built with <a href=\"https://qpm.quantumlogicslimited.com/package/quantum-site\">quantum-site</a> · <a href=\"{{ \"feed.xml\" | rel }}\">RSS</a>{{#if site.params.github}} · <a href=\"{{ site.params.github }}\">GitHub</a>{{/if}}</p>",
            "    </div>",
            "  </footer>",
            ""
        ].join("\n")})
        list.push({"path": "layouts/partials/header.html", "text": [
            "  <header class=\"site-header\">",
            "    <div class=\"container header-inner\">",
            "      <a class=\"brand\" href=\"{{ \"index.html\" | rel }}\">{{ site.title }}</a>",
            "      <nav class=\"site-nav\">",
            "        {{#each site.nav as item}}<a href=\"{{ item.url | rel }}\"{{#if page.url == item.url}} class=\"active\"{{/if}}>{{ item.title }}</a>{{/each}}",
            "      </nav>",
            "    </div>",
            "  </header>",
            ""
        ].join("\n")})
        list.push({"path": "layouts/partials/post-card.html", "text": [
            "<article class=\"card\">",
            "  <h2 class=\"card-title\"><a href=\"{{ url | rel }}\">{{ title }}</a></h2>",
            "  <p class=\"meta\">{{ date | date }} · {{ readingTime }} min read</p>",
            "  <p>{{ summary }}</p>",
            "  {{#if tagLinks}}<p class=\"tags\">{{#each tagLinks}}<a class=\"tag\" href=\"{{ url | rel }}\">#" + "{{ name }}</a>{{/each}}</p>{{/if}}",
            "</article>",
            ""
        ].join("\n")})
        list.push({"path": "layouts/post.html", "text": [
            "---",
            "layout: base",
            "---",
            "<article class=\"post\">",
            "  <header class=\"post-header\">",
            "    <h1>{{ page.title }}</h1>",
            "    <p class=\"meta\">{{ page.date | date }} · {{ page.readingTime }} min read{{#if site.author}} · {{ site.author }}{{/if}}</p>",
            "    {{#if page.tagLinks}}<p class=\"tags\">{{#each page.tagLinks}}<a class=\"tag\" href=\"{{ url | rel }}\">#" + "{{ name }}</a>{{/each}}</p>{{/if}}",
            "  </header>",
            "  {{#if page.toc}}{{{ page.toc }}}{{/if}}",
            "  <div class=\"post-body\">",
            "{{{ content }}}",
            "  </div>",
            "  <nav class=\"post-nav\">",
            "    {{#if page.older}}<a href=\"{{ page.older.url | rel }}\">← {{ page.older.title }}</a>{{else}}<span></span>{{/if}}",
            "    {{#if page.newer}}<a href=\"{{ page.newer.url | rel }}\">{{ page.newer.title }} →</a>{{/if}}",
            "  </nav>",
            "</article>",
            ""
        ].join("\n")})
        list.push({"path": "layouts/tag.html", "text": [
            "---",
            "layout: base",
            "---",
            "<section class=\"hero small\">",
            "  <h1>#" + "{{ page.tag.name }}</h1>",
            "  <p class=\"lead\">{{ page.tag.count }} {{ page.tag.count | plural \"post\" \"posts\" }}</p>",
            "</section>",
            "<section class=\"post-list\">",
            "{{#each page.posts}}",
            "{{> post-card}}",
            "{{/each}}",
            "</section>",
            "<p><a href=\"{{ \"tags/index.html\" | rel }}\">← All tags</a></p>",
            ""
        ].join("\n")})
        list.push({"path": "layouts/tags.html", "text": [
            "---",
            "layout: base",
            "---",
            "<article class=\"page\">",
            "  <h1>Tags</h1>",
            "  <p class=\"tag-cloud\">",
            "  {{#each site.tags}}<a class=\"tag\" href=\"{{ url | rel }}\">#" + "{{ name }} <span class=\"count\">{{ count }}</span></a>",
            "  {{else}}No tags yet.{{/each}}",
            "  </p>",
            "</article>",
            ""
        ].join("\n")})
        list.push({"path": "static/style.css", "text": [
            ":root {",
            "  --bg: #fbfaf7;",
            "  --fg: #1f2328;",
            "  --muted: #6a737d;",
            "  --line: #e6e2d9;",
            "  --card: #ffffff;",
            "  --accent: #5b4bdb;",
            "  --accent-soft: #ece9ff;",
            "  --code-bg: #f3f1ec;",
            "  --radius: 12px;",
            "  --font: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif;",
            "  --mono: ui-monospace, \"Cascadia Code\", Consolas, monospace;",
            "}",
            "@media (prefers-color-scheme: dark) {",
            "  :root {",
            "    --bg: #111214;",
            "    --fg: #e8e6e3;",
            "    --muted: #9aa0a6;",
            "    --line: #2a2c31;",
            "    --card: #17181b;",
            "    --accent: #9d92ff;",
            "    --accent-soft: #24213d;",
            "    --code-bg: #1d1f23;",
            "  }",
            "}",
            "* { box-sizing: border-box; }",
            "html { font-size: 17px; }",
            "body {",
            "  margin: 0;",
            "  background: var(--bg);",
            "  color: var(--fg);",
            "  font-family: var(--font);",
            "  line-height: 1.65;",
            "}",
            "a { color: var(--accent); text-decoration: none; }",
            "a:hover { text-decoration: underline; }",
            ".container { max-width: 760px; margin: 0 auto; padding: 0 1.25rem; }",
            "main.container { padding-top: 2rem; padding-bottom: 3rem; min-height: 70vh; }",
            "",
            ".site-header { border-bottom: 1px solid var(--line); background: var(--card); }",
            ".header-inner { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; padding-top: 1rem; padding-bottom: 1rem; }",
            ".brand { font-weight: 800; font-size: 1.15rem; color: var(--fg); }",
            ".site-nav a { margin-left: 1rem; color: var(--muted); font-weight: 500; }",
            ".site-nav a:first-child { margin-left: 0; }",
            ".site-nav a.active, .site-nav a:hover { color: var(--accent); text-decoration: none; }",
            "",
            ".hero { padding: 1.5rem 0 1rem; }",
            ".hero h1 { font-size: 2.4rem; line-height: 1.15; margin: 0 0 0.5rem; letter-spacing: -0.02em; }",
            ".hero.small h1 { font-size: 1.9rem; }",
            ".lead { font-size: 1.15rem; color: var(--muted); margin: 0; }",
            "",
            ".post-list { display: grid; gap: 1rem; margin-top: 1.5rem; }",
            ".card { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.25rem 1.4rem; }",
            ".card-title { margin: 0 0 0.25rem; font-size: 1.3rem; }",
            ".card-title a { color: var(--fg); }",
            ".card p { margin: 0.4rem 0; }",
            ".meta { color: var(--muted); font-size: 0.9rem; }",
            ".tags { margin-top: 0.6rem; }",
            ".tag { display: inline-block; background: var(--accent-soft); color: var(--accent); border-radius: 999px; padding: 0.1rem 0.65rem; margin: 0 0.35rem 0.35rem 0; font-size: 0.85rem; }",
            ".tag .count { opacity: 0.7; }",
            ".tag-cloud .tag { font-size: 1rem; }",
            "",
            ".post-header h1, .page h1 { font-size: 2.1rem; line-height: 1.2; margin: 0 0 0.4rem; letter-spacing: -0.015em; }",
            ".post-body h2, .page h2 { margin-top: 2rem; }",
            ".post-nav { display: flex; justify-content: space-between; gap: 1rem; margin-top: 3rem; padding-top: 1rem; border-top: 1px solid var(--line); }",
            ".toc { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 0.75rem 1.25rem; margin: 1.5rem 0; font-size: 0.95rem; }",
            ".toc ul { margin: 0; padding-left: 1rem; }",
            ".toc .toc-h3 { margin-left: 1rem; }",
            "",
            "pre { background: var(--code-bg); border-radius: var(--radius); padding: 1rem 1.1rem; overflow-x: auto; font-size: 0.9rem; line-height: 1.5; }",
            "code { font-family: var(--mono); font-size: 0.9em; }",
            ":not(pre) > code { background: var(--code-bg); padding: 0.1rem 0.35rem; border-radius: 6px; }",
            "blockquote { margin: 1.5rem 0; padding: 0.25rem 1.25rem; border-left: 4px solid var(--accent); background: var(--accent-soft); border-radius: 0 var(--radius) var(--radius) 0; }",
            "table { width: 100%; border-collapse: collapse; margin: 1.5rem 0; font-size: 0.95rem; }",
            "th, td { border-bottom: 1px solid var(--line); padding: 0.55rem 0.6rem; }",
            "th { text-align: left; }",
            "hr { border: 0; border-top: 1px solid var(--line); margin: 2.5rem 0; }",
            "img { max-width: 100%; border-radius: var(--radius); }",
            ".task-list { list-style: none; padding-left: 0.5rem; }",
            ".archive { list-style: none; padding: 0; }",
            ".archive li { padding: 0.3rem 0; }",
            ".archive .meta { display: inline-block; min-width: 7.5rem; }",
            ".center { text-align: center; padding-top: 3rem; }",
            "",
            ".site-footer { border-top: 1px solid var(--line); color: var(--muted); font-size: 0.9rem; padding: 1.5rem 0; }",
            ".site-footer p { margin: 0; }",
            ""
        ].join("\n")})
        return list
    }

    fn paths() {
        let out = []
        for f in self.files() { out.push(f["path"]) }
        return out
    }

    # options: "title" (replaces the site title in site.json)
    fn create(root, options) {
        if options == null { options = {} }
        let title = SiteUtil.text(options.get("title", "")).replaceAll("\"", "'")
        let created = []
        let skipped = []
        SiteUtil.ensureDir(root)
        for f in self.files() {
            let path = SiteUtil.joinPath(root, f["path"])
            if os.path.exists(path) {
                skipped.push(f["path"])
                continue
            }
            let text = f["text"]
            if title != "" and f["path"] == "site.json" {
                text = text.replaceAll("My Quantum Site", title)
            }
            SiteUtil.writeText(path, text)
            created.push(f["path"])
        }
        return {"created": created, "skipped": skipped}
    }
}

SiteStarter = __QSiteStarter()
